# The pip trust FLOOR: the first pip release whose vendored certifi excludes every distrusted CA.
# pip loads that certifi in addition to the system store, so a pip below this floor trusts a
# distrusted root whatever the OS says (ADR 0058).
#
# A floor, not a pin: lib/refresh-ca-data.sh replaces only pips BELOW it, from this exact wheel,
# and leaves newer ones alone; tests/base/29-ca-trust.sh fails any pip below it. Raise it only
# when a new distrust needs a newer pip, together with the wheel's URL and SHA-256 from PyPI;
# the hash, not the TLS connection, is what makes the wheel trustworthy.
#
# Sourced by lib/refresh-ca-data.sh and tests/base/29-ca-trust.sh (L110).
#
# 2026-10: pip 26.2.2 drops the roots behind the compromised eMudhra intermediates.
PIP_FLOOR=26.2.2
PIP_FLOOR_URL=https://files.pythonhosted.org/packages/3f/06/3e4420302363fbb71be3c7f35ce042f54bfca330e3e66b3a2e3c4cca579f/pip-26.2.2-py3-none-any.whl
PIP_FLOOR_SHA256=fd7f4dfa8190e014013b9f08f3e973f4e4c26ffd179a204895533a7254813a70
PIP_FLOOR_MIN_PYTHON=10        # the floor wheel's Requires-Python: >=3.10
