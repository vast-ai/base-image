#!/bin/bash
# Decide whether a TLS certificate and private key are actually usable together.
#
#   cert-usable [CRT] [KEY]     exit 0 = usable, 1 = not (reason on stderr)
#
# Defaults to /etc/instance.crt and /etc/instance.key, the pair 55-tls-cert-gen.sh
# produces and Caddy serves.
#
# WHY THIS EXISTS
# ---------------
# Three places asked this question and gave three different wrong answers, each
# wrong in a direction its author had no fixture for.
#
#   base/27-caddy-tls.sh    openssl rsa -in KEY -check
#   caddy_config_manager    ["openssl","rsa","-in",KEY,"-check","-noout"]
#   55-tls-cert-gen.sh      sha256sum of each side's DER public key
#
# `openssl rsa` is the RSA-ONLY entry point: it cannot load an EC key at all, so
# both -check callers reject a perfectly good EC keypair and turn HTTPS off. The
# portal one is not a test — it is what gates Caddy's TLS listener. Neither
# compares the certificate to the key, so a MISMATCHED pair passes both.
#
# The digest form is latently unsafe rather than actively wrong, and the
# distinction is worth stating precisely because it is easy to overstate.
# `sha256sum` of empty input is e3b0c442…, a fixed NON-EMPTY string, so two
# openssl invocations that both fail produce identical digests and the
# comparison reports a match. The `[[ -n "$c" ]]` guard does not catch it: what
# is non-empty is the digest, not the key. But in the shipped script that
# expression sat below a `openssl x509 -noout` parse check, and every cert that
# clears that check also survives `pkey -pubin` (verified against RSA, EC, DSA,
# Ed25519, and a cert with a deliberately corrupted modulus). The fail-open was
# therefore unreachable — safe by an accident of ordering, with an inert guard
# above it claiming otherwise. That is a trap for the next edit, not a live bug.
#
# So the comparison here has no hashing step at all: emptiness cannot stop
# looking like emptiness, and the non-empty guards are load-bearing rather than
# decorative, whatever order the checks are later put in.
#
# So: compare the PEM SubjectPublicKeyInfo of each side DIRECTLY. There is no
# hashing step in which emptiness can stop looking empty, `openssl pkey -pubout`
# is key-type agnostic, and the explicit non-empty guard means a failure on
# either side can never read as agreement.
#
# Exercised against real RSA, EC, mismatched, expired, and unreadable fixtures by
# tools/imagegen/tests/test_cert_usable.py. Enforced as the single implementation
# by linter rule L066.

CRT=${1:-/etc/instance.crt}
KEY=${2:-/etc/instance.key}

_no() { echo "cert-usable: $1" >&2; exit 1; }

[[ -s "$CRT" ]] || _no "${CRT} is missing or empty"
[[ -s "$KEY" ]] || _no "${KEY} is missing or empty"

# Parseable. A curl that wrote a 5xx HTML body, or wrote nothing at all, lands here.
openssl x509 -in "$CRT" -noout >/dev/null 2>&1 \
    || _no "${CRT} is not a parseable certificate"

# Unexpired. An expired cert parses fine and makes Caddy serve a listener that
# every client rejects, which is indistinguishable from "HTTPS is broken" without
# being distinguishable from "HTTPS is fine" to a guard that only parses.
openssl x509 -in "$CRT" -noout -checkend 0 >/dev/null 2>&1 \
    || _no "${CRT} has expired"

# Matching. This is what a half-finished regeneration breaks: a cert from before,
# a key from after. `-pubout`/`-pubkey` both emit PEM SPKI, so RSA, EC and Ed25519
# all compare on equal terms.
_c=$(openssl x509 -in "$CRT" -noout -pubkey 2>/dev/null)
_k=$(openssl pkey -in "$KEY" -pubout 2>/dev/null)
[[ -n "$_c" ]] || _no "could not read a public key out of ${CRT}"
[[ -n "$_k" ]] || _no "${KEY} is not a parseable private key"
[[ "$_c" == "$_k" ]] || _no "${CRT} does not match ${KEY}"

exit 0
